{% from "nginx-macros.j2" import render_ssl_ciphers, render_csp with context %}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ item.server_name }};

    # certificates added as extra params
    ssl_session_cache shared:SSL:50m;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.3 TLSv1.2;
    {{ render_ssl_ciphers(nginx_ssl_ciphers, item.ssl_ciphers|default([]))|indent(4) }}
    ssl_prefer_server_ciphers on;
    ssl_dhparam /etc/nginx/dh{{ nginx_dh_size }}.pem;

    root /var/www/{{ item.server_name }}/{{ item.public_dir|default('') }};
    index index.php index.html index.htm;

    access_log /var/log/nginx/{{ item.server_name }}.access.log combined {% if item.debug_mode is defined and item.debug_mode %}buffer=64k flush=5s{% else %}buffer=32k flush=1m{% endif %};
    error_log /var/log/nginx/{{ item.server_name }}.error.log warn;

    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    {{ render_csp(nginx_csp_policies, item.csp_policies|default({}))|indent(4) }}

    client_max_body_size {{ nginx_client_max_body_size | default('16m') }};
    large_client_header_buffers 4 32k;

    server_tokens off;

    {% for ip in (cloudflare_ips | default([])) %}
    set_real_ip_from {{ ip }};
    {% endfor %}
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    location / {
        try_files $uri $uri/ /index.php;
    }

    # PHP-FPM
    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        include snippets/fastcgi-php.conf;
        # in some legacy apps, HTML responses often exceed default 4k/8k buffers => disk spill.
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 64k;
        fastcgi_param SERVER_ADDR {{ ansible_default_ipv4.address | default('127.0.0.1') }};
        fastcgi_param REMOTE_ADDR $remote_addr;
        # Cloudflare terminates TLS at the edge. Tell PHP-FPM it's https so web app
        # generates absolute URLs with https:// and sets secure cookies.
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_CF_CONNECTING_IP $http_cf_connecting_ip;
        fastcgi_param HTTP_CF_RAY $http_cf_ray;

        {% if item.extra_php_parameters is defined %}
            {{ item.extra_parameters|indent(8) }}
        {% endif %}
    }

    {% if item.extra_parameters is defined %}
        {{ item.extra_parameters|indent(4) }}
    {% endif %}
}
