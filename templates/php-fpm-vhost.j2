{% from "nginx-macros.j2" import render_ssl_ciphers, render_csp with context %}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ item.server_name }};

    # certificates added as extra params
    ssl_session_cache shared:SSL:50m;
    ssl_session_timeout 5m;
    ssl_protocols TLSv1.3 TLSv1.2;
    {{ render_ssl_ciphers(nginx_ssl_ciphers, item.ssl_ciphers|default([]))|indent(4) }}
    ssl_prefer_server_ciphers on;
    ssl_dhparam /etc/nginx/dh{{ nginx_dh_size }}.pem;

    root /var/www/{{ item.server_name }}/{{ item.public_dir|default('') }};
    index index.php index.html index.htm;

    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    {{ render_csp(nginx_csp_policies, item.csp_policies|default({}))|indent(4) }}

    client_max_body_size 2M;
    large_client_header_buffers 4 32k;

    server_tokens off;

    {% for ip in cloudflare_ips %}
    set_real_ip_from {{ ip }};
    {% endfor %}
    real_ip_header CF-Connecting-IP;

    location / {
        try_files $uri $uri/ /index.php;
    }

    # PHP-FPM
    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php{{ php_version_string }}-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        include snippets/fastcgi-php.conf;
        fastcgi_param SERVER_ADDR {{ ipv4_address }};
        fastcgi_param REMOTE_ADDR $http_x_forwarded_for;

        {% if item.extra_php_parameters is defined %}
            {{ item.extra_parameters|indent(8) }}
        {% endif %}
    }

    {% if item.extra_parameters is defined %}
        {{ item.extra_parameters|indent(4) }}
    {% endif %}
}
